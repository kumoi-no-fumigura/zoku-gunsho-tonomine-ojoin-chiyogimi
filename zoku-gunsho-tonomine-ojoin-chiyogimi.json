 "blocks": [
  {
   "id": "zoku-gunsho-tonomine-ojoin-chiyogimi-0001",
   "pid": "nao-729558",
   "pages": [
    1
   ],
   "text": "有栖川兵部卿幸仁親王ニ御つたへ其より背栖一同一品中務卿織仁親王江御伝来ニ明和五年紫野大徳寺寂厳和尚へ御伝へ御座候ヲ中川主税頭豊島大舎人頭両人より世界之名物と申事にて達而申受候其より亡父左兵衛尉伝来仕罷在候候以上多武峰往生院千世君歌合題涼風入簾閑山秋月藪露為玉野花錦延水有幽音恋歌人右仁昭長昭千世君恵勝長嚴長暹左静範明・成厳修勝泉園覚暹判者",
   "poems": []
  },
  {
   "id": "zoku-gunsho-tonomine-ojoin-chiyogimi-0002",
   "pid": "nao-729558",
   "pages": [
    2
   ],
   "text": "紀伊入道一番涼風入簾左仁昭わきもこかあたり能こすはまかねともまとをしに吹風を涼しき静範右あきかせのみすのまとをしふきかへてなれゑあふきのちしられすわきもこにあふき能こもをくらふれとさたかに見へすこすのまとをし二番閑山秋月長昭左につき故身そみねのこよにすみ口たるつまよふしかこゑはかりして右明一秋のよひつきすみわたる山のはゝたちよる雲のかけたにもなしつまこふるゑかもしかとはきにゆれと山にはらせやたちまさならむ三番蓑露為玉左千世君つきかけにみかける玉とみえつるははきのうはれ露にそ有ける七成厳くさむらのはなはにおける白露はいろ〳〵能くをぬけるなりけり",
   "poems": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6"
   ]
  },
  {
   "id": "zoku-gunsho-tonomine-ojoin-chiyogimi-0003",
   "pid": "nao-729558",
   "pages": [
    3
   ],
   "text": "しらつゆはゝきのうはらやおきまさるはなにかゝるはあたにみえけりたれはさもあるましきことをこのき見にさりようすとてこゝろゆかす思てなん四番野花錦延恵勝左から国におれる錦きをそれをなをやまとの秋のゝには敷かしな右修勝のへことにさまてに本へるいろ〳〵のはなのにしきとみえわたるかな楽らくにのいろにはし閑ゑあきのゝのはなの錦はつゆのあるなり五番水有幽音左長厳やまかくれやゝ閑すかにそきこゆなる水を谷川の水のなかれは右泉円いはまわく水のおとこそきこゆなれあきのよ深く成るにや有らんひをへつゝ薬すかにむけふたに閑はをよふかきこゑはなをやまさらん六番恋左長暹",
   "poems": [
    "7",
    "8",
    "9",
    "10",
    "11"
   ]
  },
  {
   "id": "zoku-gunsho-tonomine-ojoin-chiyogimi-0004",
   "pid": "nao-729558",
   "pages": [
    4
   ],
   "text": "一難にしてここからさむしのふれとかはかりみよりあまる我恋覚暹右あさましやあさまのたけの見ねことにつらきも知らす日遊る我恋みねことにあさまのたけのけふりあひて見にあまるこひのほと母しられす施水宅飲合年月同範永宅歌合年月日十番是野花小鷹狩駒迎十五夜月秋田露属霧鹿擣衣歌人一番野花左勝宮若乳母秋のもしたはのみとりなかりけりにゑきとみゆる花のにほひに右小禅師聖梵一云々",
   "poems": [
    "12",
    "13",
    "14"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "わきもこかあたり能こすはまかねともまとをしに吹風を涼しき",
   "kana": "",
   "speaker": "仁昭",
   "page": 2,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "2",
   "text": "あきかせのみすのまとをしふきかへてなれゑあふきのちしられす",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "3",
   "text": "つき故身そみねのこよにすみ口たるつまよふしかこゑはかりして",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "左",
   "dai": "に"
  },
  {
   "seq": "4",
   "text": "秋のよひつきすみわたる山のはゝたちよる雲のかけたにもなし",
   "kana": "",
   "speaker": "明一",
   "page": 2,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "二",
   "side": "右",
   "dai": "に"
  },
  {
   "seq": "5",
   "text": "つきかけにみかける玉とみえつるははきのうはれ露にそ有ける",
   "kana": "",
   "speaker": "千世君",
   "page": 2,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "6",
   "text": "くさむらのはなはにおける白露はいろ〳〵能くをぬけるなりけり",
   "kana": "",
   "speaker": "成厳",
   "page": 2,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "7",
   "text": "から国におれる錦きをそれをなをやまとの秋のゝには敷かしな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "8",
   "text": "のへことにさまてに本へるいろ〳〵のはなのにしきとみえわたるかな",
   "kana": "",
   "speaker": "修勝",
   "page": 3,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "9",
   "text": "楽らくにのいろにはし閑ゑあきのゝのはなの錦",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "四",
   "side": "",
   "dai": ""
  },
  {
   "seq": "10",
   "text": "やまかくれやゝ閑すかにそきこゆなる水を谷川の水のなかれは",
   "kana": "",
   "speaker": "長厳",
   "page": 3,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "11",
   "text": "いはまわく水のおとこそきこゆなれあきのよ深く成るにや有らん",
   "kana": "",
   "speaker": "泉円",
   "page": 3,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "12",
   "text": "一難にしてここからさむしのふれとかはかりみよりあまる我恋",
   "kana": "",
   "speaker": "長暹",
   "page": 4,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "13",
   "text": "あさましやあさまのたけの見ねことにつらきも知らす日遊る我恋",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "14",
   "text": "秋のもしたはのみとりなかりけりにゑきとみゆる花のにほひに",
   "kana": "",
   "speaker": "宮若乳母",
   "page": 4,
   "pid": "nao-729558",
   "form": "短歌",
   "genre": "",
   "ban": "一",
   "side": "左",
   "dai": "勝"
  }
 ],
